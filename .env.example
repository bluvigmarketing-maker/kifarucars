# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# The site runs without these set — it falls back to placeholder fleet/review
# content and the enquiry form will show a "not connected" message — but
# nothing writes to a database and /kifaruadmin cannot be used until they're set.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
