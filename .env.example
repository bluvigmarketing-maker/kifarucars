# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# The site runs without these set — it falls back to placeholder fleet/review
# content and the enquiry form will show a "not connected" message — but
# nothing writes to a database and /kifaruadmin cannot be used until they're set.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────
# Service-role key (Project Settings → API). Used only by the M-Pesa payment
# flow and its callback, which write payments without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# ── M-Pesa STK Push (Safaricom Daraja, developer.safaricom.co.ke) ────────
# Payments go to Buy Goods till 8999944 (Top Dollars Ltd). Online payment
# stays off in the client portal (it shows the till number instead) until
# every value below is set.
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Production: the till's store / head office number from Safaricom's go-live
# email (NOT the till number). Sandbox: 174379
MPESA_SHORTCODE=
# Production: the passkey Safaricom emails for the shortcode above.
# Sandbox: the test passkey shown on the Daraja simulator page.
MPESA_PASSKEY=
MPESA_TILL_NUMBER=8999944
# Public HTTPS origin Safaricom calls back to, e.g. https://kifarucarhire.co.ke
# (localhost won't work — use your Vercel URL or an ngrok tunnel).
MPESA_CALLBACK_BASE_URL=
# Long random string; forms the secret callback path. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=

# ── Invoice email (SMTP) ─────────────────────────────────────────────────
# Paid bookings and lease payments email the customer a PDF invoice. Off
# until HOST, USER and PASS are set. Works with any SMTP service, e.g.
#   Zoho Mail:        smtp.zoho.com, port 465 (use an app-specific password)
#   Google Workspace: smtp.gmail.com, port 465 (app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to customers, e.g. "Kifaru Car Hire <bookings@kifarucarhire.co.ke>"
# (defaults to SMTP_USER).
EMAIL_FROM=
# Optional staff inbox that gets a copy of every invoice.
INVOICE_BCC=
